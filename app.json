{
  "expo": {
    "name": "SkilledProz Hirer",
    "slug": "skilledproz-hirer",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "skilledproz",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/c4820a3d-3973-4a12-8f9a-06cf60905e00",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.skilledproz.hirer",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "SkilledProz uses your location to verify check-in at the job site.",
        "NSPhotoLibraryUsageDescription": "SkilledProz needs access to your photos so you can attach evidence to disputes.",
        "NSCameraUsageDescription": "SkilledProz uses your camera to attach photos to disputes."
      }
    },
    "android": {
      "package": "com.skilledproz.hirer",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-localization",
      "expo-updates",
      "expo-notifications",
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "SkilledProz uses your location to verify check-in at the job site."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SkilledProz needs access to your photos so you can attach evidence to disputes."
        }
      ],
      "expo-web-browser"
    ],

    "extra": {
      "API_URL": "https://api.skilledproz.com/api",
      "googleWebClientId": "981568518761-ddam93tb23968092932kb1cscrmsrkek.apps.googleusercontent.com",
      "googleAndroidClientId": "981568518761-ddam93tb23968092932kb1cscrmsrkek.apps.googleusercontent.com",
      "googleIosClientId": "981568518761-hkiq5eph9liqs32k3kpalu80u3juucdg.apps.googleusercontent.com",
      "eas": {
        "projectId": "c4820a3d-3973-4a12-8f9a-06cf60905e00"
      }
    },
    "owner": "nnamdi-michael"
  }
}
